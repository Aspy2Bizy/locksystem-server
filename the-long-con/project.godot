; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Long Con"
config/description="Realistic tactical heist FPS. Plan, infiltrate, take the bank."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

DataDB="*res://scripts/autoload/data_db.gd"
Events="*res://scripts/autoload/events.gd"
Session="*res://scripts/autoload/session.gd"
DevTools="*res://scripts/autoload/dev_tools.gd"
Net="*res://scripts/net/network_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

